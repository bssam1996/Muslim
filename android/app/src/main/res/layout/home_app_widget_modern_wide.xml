<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_modern_background"
    android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="1dp" android:paddingBottom="1dp"
    android:orientation="vertical">
    <include layout="@layout/widget_modern_dates" android:id="@id/modern_dates"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="horizontal">
        <LinearLayout android:id="@+id/fajr_card" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/fajr_label" style="@style/ModernWidgetLabel"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/fajr_label" android:gravity="center" android:textSize="12sp" />
            <TextView android:id="@+id/fajr_text" style="@style/ModernWidgetTime"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/widget_preview_fajr" android:gravity="center" android:textSize="16sp"
                android:layout_marginTop="1dp" />
            <ImageView android:id="@+id/modern_fajr_indicator" android:layout_width="4dp"
                android:layout_height="3dp" android:layout_marginTop="3dp"
                android:background="@drawable/widget_modern_indicator" android:visibility="invisible"
                android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout android:id="@+id/sunrise_card" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/sunrise_label" style="@style/ModernWidgetLabel"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/sunrise_label" android:gravity="center" android:textSize="12sp" />
            <TextView android:id="@+id/sunrise_text" style="@style/ModernWidgetTime"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/widget_preview_sunrise" android:gravity="center" android:textSize="16sp"
                android:layout_marginTop="1dp" />
            <ImageView android:id="@+id/modern_sunrise_indicator" android:layout_width="4dp"
                android:layout_height="3dp" android:layout_marginTop="3dp"
                android:background="@drawable/widget_modern_indicator" android:visibility="invisible"
                android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout android:id="@+id/dhuhr_card" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/dhuhr_label" style="@style/ModernWidgetLabel"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/dhuhr_label" android:gravity="center" android:textSize="12sp" />
            <TextView android:id="@+id/dhuhr_text" style="@style/ModernWidgetTime"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/widget_preview_dhuhr" android:gravity="center" android:textSize="16sp"
                android:layout_marginTop="1dp" />
            <ImageView android:id="@+id/modern_dhuhr_indicator" android:layout_width="4dp"
                android:layout_height="3dp" android:layout_marginTop="3dp"
                android:background="@drawable/widget_modern_indicator" android:visibility="invisible"
                android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout android:id="@+id/asr_card" android:background="@drawable/widget_modern_highlight" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/asr_label" style="@style/ModernWidgetLabel"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/asr_label" android:gravity="center" android:textSize="12sp" />
            <TextView android:id="@+id/asr_text" style="@style/ModernWidgetTime"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/widget_preview_asr" android:gravity="center" android:textSize="16sp"
                android:layout_marginTop="1dp" />
            <ImageView android:id="@+id/modern_asr_indicator" android:layout_width="4dp"
                android:layout_height="3dp" android:layout_marginTop="3dp"
                android:background="@drawable/widget_modern_indicator" android:visibility="invisible"
                android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout android:id="@+id/maghrib_card" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/maghrib_label" style="@style/ModernWidgetLabel"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/maghrib_label" android:gravity="center" android:textSize="12sp" />
            <TextView android:id="@+id/maghrib_text" style="@style/ModernWidgetTime"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/widget_preview_maghrib" android:gravity="center" android:textSize="16sp"
                android:layout_marginTop="1dp" />
            <ImageView android:id="@+id/modern_maghrib_indicator" android:layout_width="4dp"
                android:layout_height="3dp" android:layout_marginTop="3dp"
                android:background="@drawable/widget_modern_indicator" android:visibility="invisible"
                android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout android:id="@+id/isha_card" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/isha_label" style="@style/ModernWidgetLabel"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/isha_label" android:gravity="center" android:textSize="12sp" />
            <TextView android:id="@+id/isha_text" style="@style/ModernWidgetTime"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/widget_preview_isha" android:gravity="center" android:textSize="16sp"
                android:layout_marginTop="1dp" />
            <ImageView android:id="@+id/modern_isha_indicator" android:layout_width="4dp"
                android:layout_height="3dp" android:layout_marginTop="3dp"
                android:background="@drawable/widget_modern_indicator" android:visibility="invisible"
                android:importantForAccessibility="no" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
